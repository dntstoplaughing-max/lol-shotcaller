# Required for real game plans (get one at https://console.anthropic.com).
# Without it the app runs in dry-run mode: canned plan text, no API calls.
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown).
# SHOTCALLER_MODEL=claude-opus-5
# SHOTCALLER_EFFORT=low            # low | medium | high — reasoning depth vs. latency
# SHOTCALLER_MAX_PLAN_TOKENS=4000  # response cap for the full plan call
# SHOTCALLER_PROFILE=coach/profile.json  # coach profile path
# SHOTCALLER_GATE=off              # disable the session stop-loss banner
# SHOTCALLER_HINTS=off             # disable champ-select pick hints
# SHOTCALLER_RIOT_CLIENT=C:\Riot Games\Riot Client\RiotClientServices.exe
# SHOTCALLER_GAME_MODE=1           # same as the --game-mode flag
# SHOTCALLER_INTERACTIVE_TIMEOUT_S=20  # interactive mode auto-locks back to click-through (0 = never)
# SHOTCALLER_HOTKEY_QUIT=Control+Alt+Shift+Q  # panic quit
